# Allowlist: only the code, the examples and the two DAGs are tracked. Your homework (.tex), weekly_status.md,
# project_instructions.md, curriculum_ladder.md and everything the app writes under ui/data stay local.
/*
!/.gitignore
!/.mcp.json
!/LICENSE
!/README.md
!/examples/
!/deploy/
!/api/
!/scripts/
!/package.json
!/package-lock.json
!/requirements.txt
!/vercel.json
!/.vercelignore
!/ui/
/ui/data/*
!/ui/data/wu_dag.json
!/ui/data/wu_methods_dag.json
.DS_Store
node_modules/
/.vercel
__pycache__/
